{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noImplicitAny": false,
    "incremental": true,
    "jsx": "react-jsx",
    "paths": {
      "src/*": ["./src/*"],
      "shared/*": ["./src/shared/*"],
      "tasks/*": ["./src/tasks/*"],
      "map-3d/*": ["./src/map-3d/*"],
      "app/*": ["./src/app/*"]
    }
  },
  "include": ["./src", ".eslintrc.js", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["./node_modules"]
}
