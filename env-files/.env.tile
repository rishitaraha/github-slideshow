# Project Configs.
DEBUG=1 # Debug Mode (0: False, 1: True).
ENVIRONMENT=local
SENTRY_DSN=

# Authentication Server URLs.
API_ENGINE_URL=http://api
MASTER_SERVER_VERIFY_TOKEN_URL=

# Redis. Ref: https://redis.io/docs/stack/get-started/tutorials/stack-python/
REDIS_OM_URL=redis://redis:6379

# Database Configs.
RDS_DB_NAME=postgres
RDS_HOSTNAME=db
RDS_PASSWORD=postgres
RDS_PORT=5432
RDS_USERNAME=postgres
DB_POOL_MAX_CONNS=4

# Dev AWS Tokens: Required only for local development.
AWS_ACCESS_KEY_ID=
AWS_DEFAULT_REGION=ap-south-1
AWS_SECRET_ACCESS_KEY=