{
  "name": "rainbow-ui",
  "version": "5.0.0",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS='--max_old_space_size=8192' && vite build --mode development",
    "build-development": "NODE_OPTIONS='--max_old_space_size=8192' && vite build --mode development",
    "build-e2e": "NODE_OPTIONS='--max_old_space_size=8192' && vite build --mode e2e",
    "build-uat": "NODE_OPTIONS='--max_old_space_size=8192' && vite build --mode uat",
    "build-production": "vite build --mode production",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\" --fix --max-warnings=0 && tsc --extendedDiagnostics",
    "serve": "vite preview",
    "pretty-quick": "pretty-quick --pattern \"**/*.*(ts|tsx|json|js)\" --staged",
    "tests:unit": "vitest --coverage",
    "tests:debug": "node --inspect node_modules/.bin/vitest run",
    "analyze": "source-map-explorer 'dist/assets/*.js'"
  },
